{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zig-sandbox.local/schemas/execution-create.json",
  "title": "Execution create request",
  "description": "Optional properties may be omitted. Explicit JSON null is rejected because these properties are non-nullable. stdin_base64 is standard base64; decoded length and UTF-8 byte bounds are enforced by the semantic stage.",
  "type": "object",
  "additionalProperties": false,
  "required": ["generation", "argv"],
  "properties": {
    "generation": { "$ref": "generation.json" },
    "argv": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "^[^\\u0000]+(?![\\s\\S])"
      }
    },
    "cwd": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/(?:(?!\\.(?:\\.)?(?:/|$))[^/\\u0000\\\\]+(?:/(?!\\.(?:\\.)?(?:/|$))[^/\\u0000\\\\]+)*)?/?(?![\\s\\S])",
      "description": "Normalized guest-absolute path. Relative paths, `//`, `.`/`..` segments, NUL, and backslash are rejected."
    },
    "env": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?![\\s\\S])"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 4096,
        "pattern": "^[^\\u0000]*(?![\\s\\S])"
      }
    },
    "timeout_ms": { "$ref": "decimal-u64.json" },
    "stdin_base64": {
      "type": "string",
      "maxLength": 5464,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?(?![\\s\\S])",
      "description": "Standard base64. Alphabet/padding are schema-checked. Decoded byte length is a semantic-stage bound (max 4096)."
    }
  }
}
